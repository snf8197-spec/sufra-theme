{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
<section component-id="{{ componentId }}" data-testid="store-home-slider" class="s-block s-block--hero-slider s-block--full-bg wide-placeholder food-home-hero">
    <salla-slider
      id="main-slider-{{ position }}"
      auto-play
      static-when-single
      slider-config='{"lazy":"false"}'
      {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                <div class="swiper-slide w-full min-h-[300px] lg:min-h-[528px] bg-dark relative food-home-hero__slide">
                    <div style="background-image: url('{{ slide.image }}');" class="{{ slide.without_overlay ? '' : 'overlay-bg' }} bg-cover bg-center absolute inset-0 food-home-hero__image"></div>
                    <div class="container relative h-full flex items-end sm:items-center pb-14 sm:pb-0 home-slider__content food-home-hero__content">
                        <div class="w-full sm:w-4/5 md:w-7/12 lg:w-6/12 text-start text-white food-home-hero__copy">
                            {% if slide.title %}
                                <h2 data-swiper-parallax="-500" class="font-bold leading-tight mb-4 food-home-hero__title">{{ slide.title }}</h2>
                            {% endif %}
                            {% if slide.description %}
                                <p data-swiper-parallax="-300" class="line-clamp-3 description food-home-hero__description">{{ slide.description }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
